# =============================================================================
# Ví dụ biến môi trường (Vite) — sao chép thành `.env` hoặc `.env.local` rồi điền.
# File `.env` chứa giá trị thật không nên đưa lên git.
# Tài liệu: https://vite.dev/guide/env-and-mode.html
# =============================================================================

# -----------------------------------------------------------------------------
# SEO & preview khi gửi link (Open Graph / Twitter Card / canonical)
# -----------------------------------------------------------------------------

# Origin site production — KHÔNG có dấu / ở cuối.
# Dùng cho og:url, og:image (khi là path tương đối), thẻ canonical.
# Ví dụ: https://your-domain.com
VITE_SITE_URL=https://khoatranpc-portfolio.vercel.app

# Ảnh đại diện khi share link (~1200×630 px, PNG hoặc JPG) — URL tuyệt đối.
# Để trống: app dùng /favicon.svg (một số mạng xã hội thích ảnh raster lớn hơn).
# Ví dụ: https://your-domain.com/og-image.png
VITE_OG_IMAGE_URL=

# -----------------------------------------------------------------------------
# Trang Rubik — demo trên splash (/rubik)
# -----------------------------------------------------------------------------

# Một trong hai: (1) URL file .mp4 / .webm trên cùng origin hoặc CDN
# (2) Link YouTube đầy đủ — watch, shorts, youtu.be (app nhúng iframe embed).
# Ví dụ YouTube Shorts:
# VITE_RUBIK_DEMO_ADVANCED_URL=https://www.youtube.com/shorts/xxxxxxxxxxx
VITE_RUBIK_DEMO_ADVANCED_URL=https://youtube.com/shorts/oCmKjr8s5Hg

# Ví dụ: https://youtu.be/xxxxxxxxxxx
VITE_RUBIK_DEMO_BASIC_URL=
